{
  "name": "readscore",
  "version": "2.0.0",
  "private": true,
  "description": "ReadScore: focus, comfort and calm reading on any web page",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "verify": "node scripts/verify-dist.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test && npm run build && npm run verify",
    "test:browser": "node tests/browser/run.mjs",
    "test:browser:core": "node tests/browser/run.mjs core",
    "test:browser:focus": "node tests/browser/run.mjs focus",
    "test:browser:comfort": "node tests/browser/run.mjs comfort",
    "test:browser:calm": "node tests/browser/run.mjs calm",
    "test:browser:all": "node tests/browser/run.mjs local",
    "test:sites": "node tests/browser/run.mjs sites",
    "test:sites:full": "SITE_SET=full node tests/browser/run.mjs sites",
    "test:release": "npm run check && node tests/browser/run.mjs local --no-build && SITE_SET=full node tests/browser/run.mjs sites --no-build"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.5",
    "typescript": "^5.6.3",
    "vitest": "^5.0.3"
  }
}
